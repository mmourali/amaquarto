<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="sort-only" page-range-format="chicago" default-locale="en-US">
  <info>
    <!-- amaquarto edits to the Zotero style, following AMA's current reference
         examples (ama.org/american-marketing-association-journals-reference-style-examples):
         titles in headline-style capitals; books as "Title, 2nd ed. Publisher"
         without a place of publication; chapters as "in Book, First Last, ed.
         Publisher, pages" with editors' full names; "(published online Month
         Day)" and the DOI for articles in advance; the DOI for online
         articles without page numbers; websites as "(accessed Month Day,
         Year), URL" without "available at"; month or season as the issue when
         there is no issue number; dated newspaper and magazine articles;
         working papers, reports, dissertations, and presentations (an
         @unpublished entry prints its note, "working paper, University");
         forthcoming articles end with the name of the journal; up to 20
         authors listed, then "et al."; a half-inch hanging indent and no
         blank line between entries. -->
    <title>American Marketing Association (amaquarto edition)</title>
    <title-short>AMA</title-short>
    <id>http://www.zotero.org/styles/american-marketing-association-amaquarto</id>
    <link href="http://www.zotero.org/styles/american-marketing-association" rel="template"/>
    <link href="https://www.ama.org/submission-guidelines-american-marketing-association-journals/" rel="documentation"/>
    <link href="https://www.ama.org/american-marketing-association-journals-reference-style-examples/" rel="documentation"/>
    <author>
      <name>Sebastian Karcher</name>
    </author>
    <contributor>
      <name>Rintze Zelle</name>
    </contributor>
    <contributor>
      <name>Patrick O'Brien</name>
    </contributor>
    <category citation-format="author-date"/>
    <category field="social_science"/>
    <category field="communications"/>
    <summary>Reference style of the journals of the American Marketing Association</summary>
    <updated>2026-11-12T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <locale xml:lang="en">
    <terms>
      <term name="editor" form="short">
        <single>ed.</single>
        <multiple>eds.</multiple>
      </term>
      <term name="translator" form="short">
        <single>trans.</single>
        <multiple>trans.</multiple>
      </term>
    </terms>
  </locale>
  <macro name="author">
    <names variable="author">
      <name and="text" name-as-sort-order="first" sort-separator=", " delimiter=", " delimiter-precedes-last="contextual"/>
      <substitute>
        <names variable="editor"/>
        <names variable="translator"/>
        <choose>
          <if type="article-newspaper article-magazine" match="any">
            <text variable="container-title" font-style="italic"/>
          </if>
        </choose>
        <text macro="title"/>
      </substitute>
    </names>
  </macro>
  <macro name="author-short">
    <names variable="author">
      <name form="short" and="text" delimiter=", " initialize-with=". "/>
      <substitute>
        <names variable="editor"/>
        <names variable="translator"/>
        <choose>
          <if type="article-newspaper article-magazine" match="any">
            <text variable="container-title" font-style="italic"/>
          </if>
        </choose>
        <choose>
          <if type="bill book graphic legal_case legislation motion_picture song" match="any">
            <text variable="title" form="short" font-style="italic" text-case="title"/>
          </if>
          <else>
            <text variable="title" form="short" quotes="true" text-case="title"/>
          </else>
        </choose>
      </substitute>
    </names>
  </macro>
  <macro name="title">
    <choose>
      <if type="bill book graphic legal_case legislation motion_picture song" match="any">
        <text variable="title" font-style="italic" text-case="title"/>
      </if>
      <else>
        <text variable="title" quotes="true" text-case="title"/>
      </else>
    </choose>
  </macro>
  <macro name="year">
    <choose>
      <if variable="issued">
        <group delimiter=" ">
          <date variable="original-date" prefix="[" suffix="]">
            <date-part name="year"/>
          </date>
          <date variable="issued">
            <date-part name="year"/>
          </date>
        </group>
      </if>
      <else>
        <text term="no date" form="short"/>
      </else>
    </choose>
  </macro>
  <macro name="year-sort">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>
  <macro name="month-day">
    <date variable="issued" delimiter=" ">
      <date-part name="month"/>
      <date-part name="day"/>
    </date>
  </macro>
  <macro name="edition">
    <choose>
      <if is-numeric="edition">
        <group delimiter=" ">
          <number variable="edition" form="ordinal"/>
          <text term="edition" form="short"/>
        </group>
      </if>
      <else>
        <text variable="edition"/>
      </else>
    </choose>
  </macro>
  <macro name="volume-of-book">
    <choose>
      <if variable="volume">
        <group delimiter=" ">
          <text term="volume" form="short" text-case="capitalize-first"/>
          <text variable="volume"/>
        </group>
      </if>
    </choose>
  </macro>
  <macro name="editors">
    <names variable="editor translator" delimiter=", ">
      <name and="text" delimiter=", " delimiter-precedes-last="contextual"/>
      <label form="short" prefix=", "/>
    </names>
  </macro>
  <macro name="link">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="https://doi.org/"/>
      </if>
      <else>
        <text variable="URL"/>
      </else>
    </choose>
  </macro>
  <macro name="accessed">
    <choose>
      <if variable="accessed">
        <group delimiter=" " prefix="(" suffix=")">
          <text term="accessed"/>
          <date variable="accessed">
            <date-part name="month" suffix=" "/>
            <date-part name="day" suffix=", "/>
            <date-part name="year"/>
          </date>
        </group>
      </if>
    </choose>
  </macro>
  <!-- Journal: volume (issue), pages. Without an issue number, the month or
       season; without pages, the DOI; without a volume, "(published online
       Month Day)" and the DOI. -->
  <macro name="journal-details">
    <choose>
      <if variable="volume">
        <group delimiter=", ">
          <group delimiter=" ">
            <text variable="volume"/>
            <choose>
              <if variable="issue">
                <text variable="issue" prefix="(" suffix=")"/>
              </if>
              <else>
                <date variable="issued" prefix="(" suffix=")">
                  <date-part name="month"/>
                </date>
              </else>
            </choose>
          </group>
          <choose>
            <if variable="page">
              <text variable="page"/>
            </if>
            <else>
              <text macro="link"/>
            </else>
          </choose>
        </group>
      </if>
    </choose>
  </macro>
  <macro name="citation-locator">
    <group delimiter=" ">
      <label variable="locator" form="short"/>
      <text variable="locator"/>
    </group>
  </macro>
  <citation et-al-min="4" et-al-use-first="1" disambiguate-add-year-suffix="true" disambiguate-add-names="true" disambiguate-add-givenname="true" collapse="year">
    <sort>
      <key macro="author-short"/>
      <key macro="year-sort"/>
    </sort>
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=", ">
        <group delimiter=" ">
          <text macro="author-short"/>
          <text macro="year"/>
        </group>
        <text macro="citation-locator"/>
      </group>
    </layout>
  </citation>
  <bibliography et-al-min="21" et-al-use-first="20" entry-spacing="0" hanging-indent="true">
    <!-- Works of the same authors in the same year are ordered by title -->
    <sort>
      <key macro="author"/>
      <key macro="year-sort"/>
      <key variable="title"/>
    </sort>
    <layout suffix=".">
      <group delimiter=", ">
        <group delimiter=" ">
          <text macro="author"/>
          <text macro="year" prefix="(" suffix=")"/>
        </group>
        <choose>
          <!-- Books -->
          <if type="book" match="any">
            <group delimiter=". ">
              <group delimiter=", ">
                <text macro="title"/>
                <text macro="edition"/>
                <text macro="volume-of-book"/>
                <text macro="editors"/>
              </group>
              <text variable="publisher"/>
            </group>
          </if>
          <!-- Chapters and papers in published proceedings -->
          <else-if type="chapter paper-conference" match="any">
            <choose>
              <if variable="container-title">
                <group delimiter=", ">
                  <text macro="title"/>
                  <group delimiter=". ">
                    <group delimiter=", ">
                      <group delimiter=" ">
                        <text term="in"/>
                        <text variable="container-title" font-style="italic" text-case="title"/>
                      </group>
                      <text variable="collection-title" text-case="title"/>
                      <text macro="volume-of-book"/>
                      <text macro="editors"/>
                    </group>
                    <group delimiter=", ">
                      <text variable="publisher"/>
                      <text variable="page"/>
                    </group>
                  </group>
                </group>
              </if>
              <else>
                <!-- Presentations -->
                <group delimiter=", ">
                  <text macro="title"/>
                  <group delimiter=" ">
                    <group delimiter=", ">
                      <group delimiter=" ">
                        <text value="paper presented at"/>
                        <text variable="event" text-case="title"/>
                      </group>
                      <text variable="event-place"/>
                    </group>
                    <text macro="month-day" prefix="(" suffix=")"/>
                  </group>
                </group>
              </else>
            </choose>
          </else-if>
          <!-- Newspapers and magazines -->
          <else-if type="article-newspaper article-magazine" match="any">
            <group delimiter=", ">
              <text macro="title"/>
              <choose>
                <if variable="volume">
                  <group delimiter=", ">
                    <choose>
                      <if variable="author">
                        <text variable="container-title" font-style="italic"/>
                      </if>
                    </choose>
                    <text macro="journal-details"/>
                  </group>
                </if>
                <else>
                  <group delimiter=", ">
                    <group delimiter=" ">
                      <choose>
                        <if variable="author">
                          <text variable="container-title" font-style="italic"/>
                        </if>
                      </choose>
                      <text macro="month-day" prefix="(" suffix=")"/>
                    </group>
                    <choose>
                      <if variable="page">
                        <text variable="page"/>
                      </if>
                      <else>
                        <text macro="link"/>
                      </else>
                    </choose>
                  </group>
                </else>
              </choose>
            </group>
          </else-if>
          <!-- Journal articles -->
          <else-if type="article-journal">
            <group delimiter=", ">
              <text macro="title"/>
              <choose>
                <if variable="volume">
                  <group delimiter=", ">
                    <text variable="container-title" font-style="italic"/>
                    <text macro="journal-details"/>
                  </group>
                </if>
                <else>
                  <!-- Articles in advance, which have a DOI: "(published online
                       Month Day), DOI". A forthcoming article (year = {forthcoming})
                       has none and ends with the name of the journal. -->
                  <group delimiter=", ">
                    <group delimiter=" ">
                      <text variable="container-title" font-style="italic"/>
                      <choose>
                        <if variable="DOI URL" match="any">
                          <choose>
                            <if variable="status" match="none">
                              <group delimiter=" " prefix="(" suffix=")">
                                <text value="published online"/>
                                <text macro="month-day"/>
                              </group>
                            </if>
                          </choose>
                        </if>
                      </choose>
                    </group>
                    <text macro="link"/>
                  </group>
                </else>
              </choose>
            </group>
          </else-if>
          <!-- Dissertations -->
          <else-if type="thesis">
            <group delimiter=", ">
              <text macro="title"/>
              <choose>
                <if variable="genre">
                  <text variable="genre"/>
                </if>
                <else>
                  <text value="doctoral dissertation"/>
                </else>
              </choose>
              <text variable="publisher"/>
              <text variable="publisher-place"/>
            </group>
          </else-if>
          <!-- Websites -->
          <else-if type="webpage post post-weblog" match="any">
            <group delimiter=", ">
              <group delimiter=" ">
                <text macro="title"/>
                <text variable="container-title" font-style="italic"/>
                <choose>
                  <if variable="accessed">
                    <text macro="accessed"/>
                  </if>
                  <else>
                    <text macro="month-day" prefix="(" suffix=")"/>
                  </else>
                </choose>
              </group>
              <text macro="link"/>
            </group>
          </else-if>
          <!-- Working papers, reports, preprints, and everything else -->
          <else>
            <group delimiter=", ">
              <text macro="title"/>
              <group delimiter=" ">
                <text variable="genre"/>
                <text variable="number"/>
              </group>
              <group delimiter=" ">
                <group delimiter=", ">
                  <text variable="publisher"/>
                  <text variable="archive"/>
                </group>
                <choose>
                  <if variable="volume page" match="none">
                    <text macro="month-day" prefix="(" suffix=")"/>
                  </if>
                </choose>
              </group>
              <text variable="publisher-place"/>
              <choose>
                <if type="manuscript">
                  <text variable="note"/>
                </if>
              </choose>
              <text macro="accessed"/>
              <text macro="link"/>
            </group>
          </else>
        </choose>
      </group>
    </layout>
  </bibliography>
</style>
